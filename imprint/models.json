{
  "embedding_models": {
    "bge-small": {
      "id": "BAAI/bge-small-en-v1.5",
      "dims": 384,
      "max_seq": 512,
      "memory_mb": 24,
      "cpu_only": true,
      "description": "Small, fast embedding model for semantic caching"
    },
    "bge-base": {
      "id": "BAAI/bge-base-en-v1.5",
      "dims": 768,
      "max_seq": 512,
      "memory_mb": 86,
      "cpu_only": false,
      "description": "More accurate but larger embedding model"
    }
  },
  "compression_models": {
    "llmlingua": {
      "id": "microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank",
      "memory_mb": 420,
      "cpu_only": true,
      "description": "Post-training 4-bit quantization for LLMs with minimal accuracy loss"
    }
  },
  "fallback_chain": {
    "semantic_cache": {
      "enabled": true,
      "top_k": 5,
      "threshold": 0.85,
      "type": "cosine",
      "description": "Semantic similarity search across prompt variations"
    },
    "prefix_tree": {
      "enabled": true,
      "max_depth": 64,
      "description": "O(1) lookup for prefix-based routing"
    },
    "compression": {
      "enabled": true,
      "threshold_tokens": 1024,
      "max_ratio": 0.5,
      "methods": ["llmlingua", "heuristic", "truncation"],
      "description": "Adaptive token compression for long context"
    }
  },
  "cache": {
    "semantic_ttl_hours": 168,
    "prefix_ttl_hours": 720,
    "max_entries": 100000,
    "cleanup_interval_hours": 24
  }
}